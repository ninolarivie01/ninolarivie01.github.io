---
// Un document présenté par la miniature de sa première page : toute la carte est un seul lien,
// qui ouvre le PDF dans un nouvel onglet (annoncé aux lecteurs d'écran).
import { Image } from 'astro:assets';
import type { Production } from '../lib/productions';

interface Props {
  production: Production;
}
const { production: p } = Astro.props;
---

<a href={p.fichier} target="_blank" rel="noopener" class="carte">
  {
    p.miniature ? (
      <Image src={p.miniature} alt="" width={120} densities={[1, 2, 3]} class="miniature" />
    ) : (
      <span class="miniature vide" aria-hidden="true">{p.format}</span>
    )
  }
  <span class="texte">
    <span class="type">{p.libelleType}</span>
    <span class="titre">{p.titre}</span>
    <span class="detail">{p.format}, {p.taille}, s'ouvre dans un nouvel onglet</span>
  </span>
</a>

<style>
  .carte {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    text-decoration: none;
  }
  .carte :global(.miniature) {
    display: block;
    width: 5.5rem;
    height: auto;
    aspect-ratio: 210 / 297;
    object-fit: cover;
    object-position: top;
    background: #fff;
    border: 1px solid var(--filet);
    box-shadow: 3px 3px 0 var(--fond-2);
  }
  .vide {
    display: grid;
    place-items: center;
    font: 700 0.8125rem/1 var(--titre);
    color: var(--gris);
  }
  .texte {
    display: grid;
    gap: 0.15rem;
    padding-top: 0.15rem;
  }
  .type,
  .detail {
    font: 400 0.8125rem/1.4 var(--titre);
    color: var(--gris);
  }
  .titre {
    font: 600 1.0625rem/1.3 var(--titre);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .carte:hover .titre {
    color: var(--brique);
    text-decoration-thickness: 2px;
  }
  .carte:hover :global(.miniature) {
    border-color: var(--brique);
    box-shadow: 3px 3px 0 var(--brique);
  }
  @media (prefers-reduced-motion: no-preference) {
    .carte :global(.miniature) {
      transition:
        border-color var(--duree),
        box-shadow var(--duree);
    }
  }
  @media print {
    .carte :global(.miniature) {
      box-shadow: none;
    }
  }
</style>
