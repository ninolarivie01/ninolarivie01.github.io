---
// Tableau réalisations × compétences, généré à partir des fiches.
// Sert à l'accueil et sur la page « Tableau de synthèse ».
import { COMPETENCES } from '../data/competences';
import { realisationsParGroupe, realisationsPubliees, periode } from '../lib/realisations';

interface Props {
  /** Affiche la période de chaque réalisation et la ligne des totaux */
  detaille?: boolean;
}
const { detaille = false } = Astro.props;
const groupes = await realisationsParGroupe();
const toutes = await realisationsPubliees();
const total = (id: string) => toutes.filter((r) => (r.data.competences as string[]).includes(id)).length;
const nbColonnes = COMPETENCES.length + (detaille ? 2 : 1);
---

<div class="defilement matrice" role="region" aria-label="Tableau des réalisations, défilable horizontalement" tabindex="0">
  <table>
    <caption class="sr">Réalisations et compétences du bloc 1 qu'elles mobilisent</caption>
    <thead>
      <tr>
        <th scope="col" class="col-titre">Réalisation</th>
        {detaille && <th scope="col" class="col-periode">Période</th>}
        {
          COMPETENCES.map((c) => (
            <th scope="col" class="col-comp">
              <a href={`/competences/#${c.id}`} title={c.titre}>
                {c.court}
              </a>
            </th>
          ))
        }
      </tr>
    </thead>
    {
      groupes.map((g) => (
        <tbody>
          <tr class="groupe">
            <th colspan={nbColonnes} scope="colgroup">
              {g.titre}
            </th>
          </tr>
          {g.realisations.map((r) => (
            <tr>
              <th scope="row">
                <a href={`/realisations/${r.id}/`}>{r.data.titre}</a>
              </th>
              {detaille && (
                <td class="periode">
                  {periode(r.data) ?? <mark class="a-completer">[À COMPLÉTER : dates]</mark>}
                </td>
              )}
              {COMPETENCES.map((c) =>
                (r.data.competences as string[]).includes(c.id) ? (
                  <td class="oui" data-c={c.court}>
                    <span class="sr">oui</span>
                  </td>
                ) : (
                  <td />
                ),
              )}
            </tr>
          ))}
        </tbody>
      ))
    }
    {
      detaille && (
        <tfoot>
          <tr>
            <th scope="row" colspan="2">
              Nombre de réalisations
            </th>
            {COMPETENCES.map((c) => (
              <td>{total(c.id)}</td>
            ))}
          </tr>
        </tfoot>
      )
    }
  </table>
</div>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  thead th {
    font: 600 0.8125rem/1.25 var(--titre);
    text-align: center;
    vertical-align: bottom;
    padding: 0.75rem 0.35rem;
    border-bottom: 1px solid var(--noir);
    width: 7.25rem;
  }
  thead th a {
    text-decoration: none;
  }
  thead th a:hover {
    text-decoration: underline;
  }
  thead .col-titre {
    text-align: left;
    width: auto;
  }
  thead .col-periode {
    text-align: left;
    width: 10rem;
  }
  tbody th {
    text-align: left;
    font-weight: 400;
    padding: 0.55rem 1rem 0.55rem 0;
    border-bottom: 1px solid var(--filet);
  }
  tbody th a {
    text-decoration: none;
  }
  tbody th a:hover {
    text-decoration: underline;
  }
  tbody td {
    text-align: center;
    border-bottom: 1px solid var(--filet);
    border-left: 1px solid var(--fond-2);
  }
  tbody td.periode {
    text-align: left;
    font: 400 0.8125rem/1.3 var(--titre);
    color: var(--gris);
    font-variant-numeric: tabular-nums;
    border-left: 0;
    padding-right: 0.75rem;
  }
  .oui::before {
    content: '';
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--brique);
    vertical-align: middle;
  }
  .groupe th {
    font: 700 0.875rem/1.2 var(--titre);
    padding: 1.4rem 0 0.5rem;
    border-bottom: 1px solid var(--noir);
    color: var(--brique);
  }
  tfoot th,
  tfoot td {
    font: 600 0.875rem/1.2 var(--titre);
    padding: 0.75rem 0.35rem 0.75rem 0;
    border-top: 1px solid var(--noir);
    text-align: center;
  }
  tfoot th {
    text-align: left;
  }

  /* Lecture assistée : la ligne survolée et la colonne de la compétence survolée ressortent */
  tbody tr:not(.groupe):hover > *,
  tbody tr:not(.groupe):focus-within > * {
    background: var(--fond-2);
  }
  table:has(thead th:nth-last-child(6):hover) tbody td:nth-last-child(6),
  table:has(thead th:nth-last-child(5):hover) tbody td:nth-last-child(5),
  table:has(thead th:nth-last-child(4):hover) tbody td:nth-last-child(4),
  table:has(thead th:nth-last-child(3):hover) tbody td:nth-last-child(3),
  table:has(thead th:nth-last-child(2):hover) tbody td:nth-last-child(2),
  table:has(thead th:nth-last-child(1):hover) tbody td:nth-last-child(1) {
    background: var(--fond-2);
  }

  /* Petit écran : chaque ligne devient une entrée avec ses compétences en clair */
  @media (max-width: 40rem) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    tbody tr:not(.groupe) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--filet);
    }
    tbody tr:not(.groupe) th,
    td.periode {
      flex: 1 0 100%;
      border: 0;
      padding: 0 0 0.2rem;
    }
    /* Les cellules sortent du modèle de tableau : sinon la fusion des bordures efface celle des étiquettes */
    table,
    tbody {
      display: block;
    }
    tbody td {
      display: inline-block;
      border: 0;
    }
    tbody td:empty {
      display: none;
    }
    tbody td.oui {
      font: 500 0.75rem/1 var(--titre);
      padding: 0.35rem 0.5rem;
      border: 1px solid var(--brique);
      color: var(--brique);
    }
    .oui::before {
      display: none;
    }
    .oui::after {
      content: attr(data-c);
    }
    tbody tr.groupe,
    .groupe th {
      display: block;
    }
    tfoot {
      display: none;
    }
  }

  @media print {
    .matrice {
      overflow: visible;
    }
    thead th {
      width: auto;
    }
    .oui::before {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
