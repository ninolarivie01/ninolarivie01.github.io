---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { dateLongue } from '../lib/realisations';

const certifications = await getCollection('certifications');
const STATUTS = { obtenue: 'Obtenue', 'en-cours': 'En cours', 'a-completer': null };
---

<Base
  titre="Certifications et formations"
  description="Les certifications et formations complémentaires que j'ai suivies en parallèle de mon BTS SIO option SISR."
>
  <header class="entete-page">
    <h1>Certifications et formations</h1>
    <p>Ce que j'ai suivi en dehors du programme du BTS. Chaque ligne renvoie, quand je l'ai, à l'attestation.</p>
  </header>

  <table class="certifs">
    <thead>
      <tr>
        <th scope="col">Formation</th>
        <th scope="col">Organisme</th>
        <th scope="col">Statut</th>
        <th scope="col">Attestation</th>
      </tr>
    </thead>
    <tbody>
      {
        certifications.map((c) => (
          <tr>
            <th scope="row">
              {c.data.nom}
              {c.data.note && <span class="note">{c.data.note}</span>}
            </th>
            <td>{c.data.organisme}</td>
            <td>
              {STATUTS[c.data.statut] ?? '—'}
              {c.data.date && <>, {dateLongue.format(c.data.date)}</>}
            </td>
            <td>{c.data.preuve ? <a href={c.data.preuve}>PDF</a> : '—'}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>

<style>
  .certifs {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 1rem 0.85rem 0;
    border-bottom: 1px solid var(--filet);
  }
  thead th {
    font: 600 0.8125rem/1.3 var(--titre);
    border-bottom: 1px solid var(--noir);
  }
  tbody th {
    font-weight: 600;
  }
  .note {
    display: block;
    font-weight: 400;
    margin-top: 0.3rem;
  }
  @media (max-width: 40rem) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    tr {
      display: grid;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--filet);
    }
    th,
    td {
      border: 0;
      padding: 0.15rem 0;
    }
  }
</style>
