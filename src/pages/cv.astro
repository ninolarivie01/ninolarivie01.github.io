---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import ACompleter from '../components/ACompleter.astro';
import Courriel from '../components/Courriel.astro';
import { PROFIL } from '../data/profil';

const PDF = '/documents/cv-nino-lariviere-gillet.pdf';
const pdfPresent = existsSync(join(process.cwd(), 'public', PDF));
---

<Base
  titre="CV"
  description="CV de Nino Larivière-Gillet, apprenti technicien support et infrastructure en BTS SIO option SISR, en alternance au Département d'Ille-et-Vilaine."
>
  <header class="entete-page">
    <h1>Curriculum vitæ</h1>
    <p>{PROFIL.fonction}, {PROFIL.ville}.</p>
  </header>

  <!-- En-tête du CV imprimé ou exporté en PDF, à la place de celui du site -->
  <div class="entete-imprime" aria-hidden="true">
    <p class="nom">{PROFIL.nom}</p>
    <p>BTS SIO option SISR, {PROFIL.fonction.toLowerCase()}, {PROFIL.ville}</p>
    <p><Courriel /> · {decodeURI(PROFIL.linkedin.replace('https://www.', ''))} · portfolio : ninolarivie01.github.io</p>
  </div>

  <p class="telechargement pas-imprime">
    {
      pdfPresent ? (
        <a href={PDF} download class="lien-fort">
          Télécharger le CV en PDF
        </a>
      ) : (
        <ACompleter>déposer le CV en PDF dans public{PDF}</ACompleter>
      )
    }
  </p>

  <div class="cv">
    <section aria-labelledby="cv-exp">
      <h2 id="cv-exp">Expérience</h2>
      <dl>
        <dt>Sept. 2026 – juil. 2027</dt>
        <dd>
          <h3>Apprenti technicien support de niveau 1, centre de service</h3>
          <p class="org">Direction des services numériques, Département d'Ille&#8209;et&#8209;Vilaine, Rennes</p>
          <ul>
            <li>Assistance sur site et prise en main à distance avec MECM</li>
            <li>Masterisation de postes d'occasion sous Windows 11 par PXE</li>
            <li>Suivi des postes dans Active Directory, MECM et EasyVista</li>
            <li>Support utilisateurs et incidents sous EasyVista, échanges de ports au brassage</li>
            <li>Transmission des demandes au prestataire</li>
          </ul>
        </dd>
        <dt>Juin – juil. 2026</dt>
        <dd>
          <h3>Stagiaire, support informatique</h3>
          <p class="org">Service informatique hospitalier, Pôle Saint-Hélier, Rennes</p>
          <ul>
            <li>Traitement des demandes d'assistance sous GLPI</li>
            <li>Gestion du parc sous GLPI : entrées et sorties de postes</li>
          </ul>
        </dd>
      </dl>
    </section>

    <section aria-labelledby="cv-autres">
      <h2 id="cv-autres">Emplois d'été et engagement</h2>
      <dl>
        <dt>2021 et 2023</dt>
        <dd>
          <h3>Agent d'entretien, 1 puis 3 semaines</h3>
          <p class="org">Derichebourg, usine de peinture Stellantis, Saint-Jacques-de-la-Lande</p>
        </dd>
        <dt>2022</dt>
        <dd>
          <h3>Agent de fabrication, 6 semaines</h3>
          <p class="org">Sanden Manufacturing Europe, par Randstad Inhouse</p>
          <ul>
            <li>Usinage de pièces de compresseur, contrôle de leur conformité</li>
          </ul>
        </dd>
        <dt>2018 – 2020</dt>
        <dd>
          <h3>Agent d'entretien communal, 4 semaines</h3>
          <p class="org">Commune de La Baussaine</p>
        </dd>
        <dt>2015 – 2018</dt>
        <dd>
          <h3>Bénévolat</h3>
          <p class="org">Conseil municipal des jeunes, puis CCAS de La Baussaine</p>
          <ul>
            <li>Propositions et organisation de sorties pour les jeunes de la commune</li>
            <li>Service lors d'un après-midi pour les personnes âgées</li>
          </ul>
        </dd>
      </dl>
    </section>

    <section aria-labelledby="cv-form">
      <h2 id="cv-form">Formation</h2>
      <dl>
        <dt>2025 – 2027</dt>
        <dd>
          <h3>BTS SIO, option SISR</h3>
          <p class="org">AFTEC Rennes, en alternance</p>
        </dd>
        <dt>2024 – 2025</dt>
        <dd>
          <h3>Master Monnaie, Banque, Finance, Assurance, commencé</h3>
          <p class="org">Arrêté pour me réorienter vers l'informatique</p>
        </dd>
        <dt>2021 – 2024</dt>
        <dd>
          <h3>Licence Économie-Gestion, obtenue</h3>
          <p class="org">Université de Rennes 1</p>
        </dd>
        <dt>2021</dt>
        <dd>
          <h3>Baccalauréat général, mention assez bien</h3>
          <p class="org">Lycée Saint-Martin, Rennes</p>
        </dd>
      </dl>
    </section>

    <section aria-labelledby="cv-tech">
      <h2 id="cv-tech">Environnements utilisés</h2>
      <dl class="tech">
        <dt>Systèmes</dt>
        <dd>Windows 10 et 11, Windows Server, Debian 13, Ubuntu, Kali Linux</dd>
        <dt>Services</dt>
        <dd>Active Directory, GPO, DNS, DHCP, BIND9, isc-dhcp-server</dd>
        <dt>Gestion de parc et ticketing</dt>
        <dd>GLPI, EasyVista, MECM, Nexthink, déploiement PXE, BitLocker</dd>
        <dt>Réseau et sécurité</dt>
        <dd>FortiGate : VLAN, filtrage, NAT ; Cisco Packet Tracer, Wireshark</dd>
        <dt>Virtualisation et conteneurs</dt>
        <dd>VMware Workstation, Docker Compose</dd>
        <dt>Web</dt>
        <dd>HTML, CSS, JavaScript, PHP, WordPress, Astro, Git et GitHub</dd>
        <dt>Bureautique</dt>
        <dd>Pack Office : Word, Access, VBA</dd>
      </dl>
    </section>

    <section aria-labelledby="cv-plus">
      <h2 id="cv-plus">Langues et centres d'intérêt</h2>
      <dl class="tech">
        <dt>Anglais</dt>
        <dd>B2 – C1</dd>
        <dt>Espagnol</dt>
        <dd>B1</dd>
        <dt>Centres d'intérêt</dt>
        <dd>Course à pied, cinéma, jeux vidéo et esport, sorties entre amis</dd>
        <dt>Certifications</dt>
        <dd>Trois badges Cisco Networking Academy, 2026 : Networking Basics, Networking Devices and Initial Configuration, Network Addressing and Basic Troubleshooting</dd>
      </dl>
      <p class="pas-imprime">Certifications : voir la page <a href="/certifications/">Certifications et formations</a>.</p>
    </section>

    <section aria-labelledby="cv-contact" class="pas-imprime">
      <h2 id="cv-contact">Contact</h2>
      <p><Courriel /></p>
      <p><a href={PROFIL.linkedin} rel="me noopener">Profil LinkedIn</a></p>
    </section>
  </div>
</Base>

<style>
  .telechargement {
    margin: 0 0 2rem;
  }
  .cv {
    display: grid;
    gap: 2.5rem;
    max-width: 52rem;
  }
  h2 {
    font-size: 1.375rem;
    font-weight: 700;
    padding-top: 0.75rem;
    border-top: 1px solid var(--noir);
    margin-bottom: 1rem;
  }
  dl {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem 2rem;
    margin: 0;
  }
  dt {
    font: 600 0.875rem/1.6 var(--titre);
    font-variant-numeric: tabular-nums;
  }
  dd {
    margin: 0;
  }
  h3 {
    font-size: 1.0625rem;
    font-weight: 700;
  }
  .org {
    margin: 0.15rem 0 0.4rem;
    color: var(--gris);
  }
  dd ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
  }
  dd li::marker {
    color: var(--brique);
  }
  .tech dd {
    font-size: 0.9375rem;
  }
  section p {
    margin: 0 0 0.5rem;
  }
  .entete-imprime {
    display: none;
  }
  @media print {
    :global(.site-entete),
    .entete-page {
      display: none !important;
    }
    .entete-imprime {
      display: block;
      border-bottom: 2px solid var(--noir);
      padding-bottom: 0.4rem;
      margin-bottom: 0.9rem;
      font: 400 8.5pt/1.4 var(--titre);
    }
    .entete-imprime p {
      margin: 0;
    }
    .entete-imprime .nom {
      font: 700 20pt/1.1 var(--titre);
      margin-bottom: 0.2rem;
    }
    .cv {
      max-width: none;
      grid-template-columns: 1fr 1.25fr 1fr;
      gap: 0.6rem 1.4rem;
      font-size: 8.5pt;
      line-height: 1.35;
    }
    .cv > section:first-child,
    .cv > section:nth-child(2) {
      grid-column: 1 / -1;
    }
    h2 {
      font-size: 11pt;
      padding-top: 0.25rem;
      margin-bottom: 0.4rem;
    }
    h3 {
      font-size: 9pt;
    }
    dl {
      grid-template-columns: 8.75rem minmax(0, 1fr);
      gap: 0.3rem 0.8rem;
    }
    .cv > section:nth-child(n + 3) dl {
      grid-template-columns: 1fr;
      gap: 0.05rem;
    }
    .cv > section:nth-child(n + 3) dd + dt {
      margin-top: 0.3rem;
    }
    dt {
      font-size: 8pt;
    }
    .org {
      margin: 0 0 0.15rem;
    }
    dd ul,
    .tech dd {
      font-size: inherit;
    }
  }
  @media (max-width: 40rem) {
    dl {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    dd + dt {
      margin-top: 1rem;
    }
  }
</style>
